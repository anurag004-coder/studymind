{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/static/index.css", "destination": "/index.css" },
    { "source": "/static/app.js", "destination": "/app.js" },
    { "source": "/static/:match*", "destination": "/:match*" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
