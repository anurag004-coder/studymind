{
  "version": 2,
  "builds": [
    { "src": "*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/index.css", "dest": "/index.css" },
    { "src": "/static/app.js", "dest": "/app.js" },
    { "src": "/app", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
