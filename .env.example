# StudyMind Environment Configuration
# Copy this file to .env and fill in real values

# App Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="StudyMind"
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studymind
# For local testing without Postgres, can use:
# DATABASE_URL=sqlite+aiosqlite:///./studymind.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=studymind_chunks

# Object Storage (Local disk or S3/MinIO)
STORAGE_BACKEND=local
# Options: local | s3
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=studymind
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Security & Auth
JWT_SECRET=supersecret-studymind-jwt-token-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# LLM_PROVIDER options: gemini | openai | anthropic | ollama | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.0

# Vision / OCR Model Fallback
VISION_LLM_MODEL=gemini-2.5-flash

# Embeddings & Reranker
# EMBEDDING_PROVIDER options: bge-m3 | openai | gemini | mock
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# RERANKER_PROVIDER options: bge-reranker | cohere | mock
RERANKER_PROVIDER=bge-reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Verifier Model
VERIFIER_MODEL=gemini-2.5-flash

# Grounding & Retrieval Thresholds
RETRIEVAL_TOP_K=30
RERANK_TOP_N=6
MIN_RELEVANCE_SCORE=0.35
ENABLE_OUTSIDE_KNOWLEDGE=false

# Ingestion Limits
MAX_UPLOAD_MB=50
MAX_PAGES=500
RATE_LIMIT_PER_MINUTE=60
